# Base URL of the FastAPI backend that /api/* requests are proxied to in local development.
# Leave unset on Vercel: vercel.json routes /api/* to the FastAPI service directly.
API_URL=http://127.0.0.1:8000

# Public ingestion key, matching the backend's project for this environment.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENVIRONMENT=development
