ENVIRONMENT=development
OPENAI_API_KEY=
CHAT_MODEL=gpt-6-luna
# Neon pooled connection for runtime; direct connection for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
PLANNING_RETENTION_DAYS=30
FLIGHT_SEARCH_TIMEOUT_SECONDS=75
FLIGHT_CACHE_SECONDS=900
WEB_ORIGIN=http://localhost:3000
# US PostHog project ingestion key. Disabled unless explicitly enabled.
POSTHOG_ENABLED=false
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Redacted model prompts/responses in AI generations; nonproduction only.
POSTHOG_CAPTURE_DEBUG_CONTENT=false
